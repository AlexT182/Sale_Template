<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="elyworld_layout_header_footer"
              inherit_id="website.layout"
              name="ElyWorld Header and Footer"
              priority="1000">

        <xpath expr="//header" position="replace">
            <header id="top" class="ew-site-header">
                <div class="ew-topbar">
                    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span>From Vietnam to the World – Quality Products, Global Access</span>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <a t-if="website.company_id.phone"
                               t-att-href="'tel:%s' % website.company_id.phone.replace(' ', '')">
                                <i class="fa fa-phone me-1"/>
                                <t t-out="website.company_id.phone"/>
                            </a>
                            <a t-if="website.company_id.email"
                               t-att-href="'mailto:%s' % website.company_id.email">
                                <i class="fa fa-envelope me-1"/>
                                <t t-out="website.company_id.email"/>
                            </a>
                            <t t-call="website.language_selector"/>
                        </div>
                    </div>
                </div>

                <nav class="navbar navbar-expand-lg ew-navbar">
                    <div class="container">
                        <a class="navbar-brand ew-brand" href="/" aria-label="ElyWorld Home">
                            <span t-field="website.logo" t-options="{'widget': 'image', 'class': 'img img-fluid', 'alt': 'ElyWorld Access'}" />
                        </a>

                        <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#ewMainNavigation"
                                aria-controls="ewMainNavigation"
                                aria-expanded="false"
                                aria-label="Mở menu">
                            <span class="navbar-toggler-icon"/>
                        </button>

                        <div class="collapse navbar-collapse" id="ewMainNavigation">
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 ew-main-menu">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu"
                                       item_class.f="nav-item"
                                       link_class.f="nav-link"/>
                                </t>
                            </ul>

                            <div class="d-flex align-items-center gap-2 ew-header-actions">
                                <a class="ew-icon-btn" href="/shop" aria-label="Tìm sản phẩm">
                                    <i class="fa fa-search"/>
                                </a>
                                <a class="ew-icon-btn" href="/shop/cart" aria-label="Giỏ hàng">
                                    <i class="fa fa-shopping-bag"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>

        <xpath expr="//footer" position="replace">
            <footer class="ew-footer">
                <div class="container py-5">
                    <div class="row g-4">
                        <div class="col-lg-3 col-md-6">
                            <a class="ew-footer-logo" href="/">
                                <span t-field="website.logo" t-options="{'widget': 'image', 'class': 'img img-fluid', 'alt': 'ElyWorld Access'}" />
                            </a>
                            <p class="mt-3 mb-3">
                                Kết nối nông sản Việt với thị trường toàn cầu thông qua chất lượng và uy tín.
                            </p>
                            <div class="d-flex gap-2">
                                <a href="#" class="ew-social"><i class="fa fa-facebook"/></a>
                                <a href="#" class="ew-social"><i class="fa fa-linkedin"/></a>
                                <a href="#" class="ew-social"><i class="fa fa-youtube-play"/></a>
                                <a href="#" class="ew-social"><i class="fa fa-instagram"/></a>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <h5>Về chúng tôi</h5>
                            <ul class="list-unstyled ew-footer-links">
                                <li><a href="/about-us">Giới thiệu</a></li>
                                <li><a href="/about-us#mission">Tầm nhìn – Sứ mệnh</a></li>
                                <li><a href="/about-us#certificates">Năng lực &amp; Chứng nhận</a></li>
                                <li><a href="/contactus">Đối tác</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <h5>Sản phẩm</h5>
                            <ul class="list-unstyled ew-footer-links">
                                <li><a href="/shop">Tất cả sản phẩm</a></li>
                                <li><a href="/shop">Sản phẩm nổi bật</a></li>
                                <li><a href="/shop">Sản phẩm mới</a></li>
                                <li><a href="/shop">Sản phẩm xuất khẩu</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <h5>Hỗ trợ</h5>
                            <ul class="list-unstyled ew-footer-links">
                                <li><a href="/terms">Chính sách giao hàng</a></li>
                                <li><a href="/terms">Chính sách đổi trả</a></li>
                                <li><a href="/terms">Điều khoản sử dụng</a></li>
                                <li><a href="/contactus">Câu hỏi thường gặp</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h5>Liên hệ</h5>
                            <ul class="list-unstyled ew-contact-list">
                                <li t-if="website.company_id.phone">
                                    <i class="fa fa-phone"/>
                                    <t t-out="website.company_id.phone"/>
                                </li>
                                <li t-if="website.company_id.email">
                                    <i class="fa fa-envelope"/>
                                    <t t-out="website.company_id.email"/>
                                </li>
                                <li t-if="website.company_id.sudo().partner_id.contact_address">
                                    <i class="fa fa-map-marker"/>
                                    <t t-out="website.company_id.sudo().partner_id.contact_address"/>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="ew-footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-4">
                        <span>© 2026 ElyWorld Access. All rights reserved.</span>
                        <button type="button" class="ew-scroll-top js_ew_scroll_top" aria-label="Lên đầu trang">
                            <i class="fa fa-arrow-up"/>
                        </button>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
