    <template id="s_ew_news" name="Elyworld News">
<!-- NEWS -->
                <section id="ew_news_edit" class="s_text_block ew-section ew-news o_colored_level oe_structure" data-snippet="s_text_block" data-name="News Block">
                    <div class="container">
                        <div class="ew-section-heading text-center">
                            <h2>Tin tức mới nhất</h2>
                            <span/>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <article class="ew-news-card">
                                    <img src="/elyworld_website_home/static/src/img/news-1.svg" alt="Healthy food trends" loading="lazy"/>
                                    <div><small>TIN TỨC</small><h3>Xu hướng thực phẩm lành mạnh trên thị trường quốc tế</h3><a href="/blog">Xem thêm →</a></div>
                                </article>
                            </div>
                            <div class="col-md-4">
                                <article class="ew-news-card">
                                    <img src="/elyworld_website_home/static/src/img/news-2.svg" alt="Dried fruit" loading="lazy"/>
                                    <div><small>SẢN PHẨM</small><h3>Lợi ích sức khỏe từ các loại hạt dinh dưỡng</h3><a href="/blog">Xem thêm →</a></div>
                                </article>
                            </div>
                            <div class="col-md-4">
                                <article class="ew-news-card">
                                    <img src="/elyworld_website_home/static/src/img/news-3.svg" alt="Export activities" loading="lazy"/>
                                    <div><small>HOẠT ĐỘNG</small><h3>ElyWorld Access tham gia hội chợ xuất khẩu</h3><a href="/blog">Xem thêm →</a></div>
                                </article>
                            </div>
                        </div>
                    </div>
                </section>
    </template>

    <template id="s_ew_contact" name="Elyworld Contact">
<!-- CONTACT -->
                <section id="contact" class="s_text_block ew-section ew-contact o_colored_level oe_structure" data-snippet="s_text_block" data-name="Contact Block">
                    <div class="container">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-4">
                                <img class="img-fluid"
                                     src="/elyworld_website_home/static/src/img/logistics-placeholder.svg"
                                     alt="Global logistics" loading="lazy"/>
                            </div>
                            <div class="col-lg-5">
                                <span class="ew-eyebrow">LIÊN HỆ VỚI CHÚNG TÔI</span>
                                <h2>Nhận tư vấn sản phẩm và xuất khẩu</h2>
                                <p>Quý khách vui lòng để lại thông tin, bộ phận Sales sẽ liên hệ trong thời gian sớm nhất.</p>

                                <div t-if="request.params.get('contact') == 'success'" class="alert alert-success">
                                    Cảm ơn Quý khách. Hệ thống đã tiếp nhận thông tin liên hệ.
                                </div>
                                <div t-if="request.params.get('contact') == 'invalid'" class="alert alert-danger">
                                    Vui lòng nhập họ tên và địa chỉ email hợp lệ.
                                </div>

                                <form action="/sale/contact/submit" method="post" class="ew-contact-form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="text" name="website_url" class="d-none" tabindex="-1" autocomplete="off"/>
                                    <div class="row g-3">
                                        <div class="col-md-6"><input class="form-control" name="company_name" placeholder="Tên công ty" maxlength="160"/></div>
                                        <div class="col-md-6"><input class="form-control" name="contact_name" placeholder="Tên người liên hệ *" required="required" maxlength="160"/></div>
                                        <div class="col-md-6"><input class="form-control" type="email" name="email" placeholder="Email *" required="required" maxlength="254"/></div>
                                        <div class="col-md-6"><input class="form-control" name="phone" placeholder="Số điện thoại" maxlength="64"/></div>
                                        <div class="col-12"><textarea class="form-control" name="message" rows="4" placeholder="Yêu cầu của bạn" maxlength="4000"/></div>
                                        <div class="col-12"><button class="btn ew-btn-primary" type="submit">Gửi thông tin <i class="fa fa-arrow-right ms-2"/></button></div>
                                    </div>
                                </form>
                            </div>
                            <div class="col-lg-3">
                                <div class="ew-contact-card">
                                    <div t-if="website.company_id.phone"><i class="fa fa-phone"/><div><strong>Hotline</strong><span t-out="website.company_id.phone"/></div></div>
                                    <div t-if="website.company_id.email"><i class="fa fa-envelope"/><div><strong>Email</strong><span t-out="website.company_id.email"/></div></div>
                                    <div t-if="website.company_id.sudo().partner_id.contact_address"><i class="fa fa-map-marker"/><div><strong>Địa chỉ</strong><span t-out="website.company_id.sudo().partner_id.contact_address"/></div></div>
                                    <div><i class="fa fa-clock-o"/><div><strong>Giờ làm việc</strong><span>Thứ 2 – Thứ 7: 8:00 – 17:30</span></div></div>
                                </div>
                                <a class="btn ew-whatsapp w-100 mt-3" href="https://wa.me/" target="_blank" rel="noopener noreferrer">
                                    <i class="fa fa-whatsapp me-2"/>Chat qua WhatsApp
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
    </template>

    <template id="sale_homepage"
              inherit_id="website.homepage"
              name="Sale Website Homepage"
              priority="1000">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="ew-homepage">
                <div class="oe_structure oe_empty" id="ew_zone_1"/>
                <t t-call="sale_website_home.s_ew_hero"/>
                <div class="oe_structure oe_empty" id="ew_zone_2"/>
                <t t-call="sale_website_home.s_ew_categories"/>
                <div class="oe_structure oe_empty" id="ew_zone_3"/>
                <t t-call="sale_website_home.s_ew_about"/>
                <div class="oe_structure oe_empty" id="ew_zone_4"/>
                <t t-call="sale_website_home.s_ew_gallery"/>
                <div class="oe_structure oe_empty" id="ew_zone_5"/>
                <t t-call="sale_website_home.s_ew_news"/>
                <div class="oe_structure oe_empty" id="ew_zone_6"/>
                <t t-call="sale_website_home.s_ew_contact"/>
                <div class="oe_structure oe_empty" id="ew_zone_7"/>
            </div>
        </xpath>
    </template>
</odoo>
