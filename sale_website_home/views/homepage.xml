    <template id="s_ew_about" name="Elyworld About">
<!-- ABOUT -->
                <section id="ew_about_edit" class="s_text_block ew-section ew-about o_colored_level oe_structure" data-snippet="s_text_block" data-name="About Block">
                    <div class="container">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-5">
                                <img class="img-fluid rounded-4 shadow-sm"
                                     src="/elyworld_website_home/static/src/img/about-placeholder.svg"
                                     alt="ElyWorld team" loading="lazy"/>
                            </div>
                            <div class="col-lg-7">
                                <span class="ew-eyebrow">VỀ ELY WORLD ACCESS</span>
                                <h2>Đưa sản phẩm Việt tiếp cận các thị trường toàn cầu</h2>
                                <p class="ew-lead">
                                    Chúng tôi chuyên cung cấp nông sản, thực phẩm và đồ uống chất lượng cao từ Việt Nam đến thị trường toàn cầu.
                                </p>
                                <div class="row row-cols-2 row-cols-md-4 g-3 my-4">
                                    <div class="col"><div class="ew-feature"><i class="fa fa-certificate"/><span>Chất lượng tiêu chuẩn quốc tế</span></div></div>
                                    <div class="col"><div class="ew-feature"><i class="fa fa-shield"/><span>Nguồn gốc rõ ràng</span></div></div>
                                    <div class="col"><div class="ew-feature"><i class="fa fa-cubes"/><span>Đa dạng sản phẩm</span></div></div>
                                    <div class="col"><div class="ew-feature"><i class="fa fa-ship"/><span>Hỗ trợ xuất khẩu</span></div></div>
                                </div>
                                <a class="btn ew-btn-primary" href="/about-us">
                                    Tìm hiểu thêm <i class="fa fa-arrow-right ms-2"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
    </template>

