                                    <small>Giấy kraft</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-export.svg" alt="Sản phẩm xuất khẩu" loading="lazy"/>
                                    <strong>Sản phẩm</strong>
