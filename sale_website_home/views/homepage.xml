                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-fruit.svg" alt="Trái cây &amp; Nông sản sấy" loading="lazy"/>
                                    <strong>Trái cây &amp;</strong>
                                    <small>Nông sản sấy</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-nuts.svg" alt="Hạt &amp; Đồ ăn vặt" loading="lazy"/>
                                    <strong>Hạt &amp;</strong>
                                    <small>Đồ ăn vặt</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-spice.svg" alt="Gia vị &amp; Rau củ sấy khô" loading="lazy"/>
                                    <strong>Gia vị &amp;</strong>
                                    <small>Rau củ sấy khô</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-drink.svg" alt="Đồ uống đóng lon" loading="lazy"/>
                                    <strong>Đồ uống</strong>
                                    <small>đóng lon</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-gift.svg" alt="Quà tặng &amp; Giỏ quà" loading="lazy"/>
                                    <strong>Quà tặng &amp;</strong>
                                    <small>Giỏ quà</small>
                                </a>
                            </div>
                            <div class="col">
                                <a class="ew-category-card" href="/shop">
                                    <img src="/elyworld_website_home/static/src/img/cat-package.svg" alt="Bao bì &amp; Giấy kraft" loading="lazy"/>
