<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_ew_hero" name="Elyworld Hero">
<!-- HERO -->
                <section id="ew_hero_edit" class="s_text_block ew-hero o_colored_level oe_structure" data-snippet="s_text_block" data-name="Hero Block">
                    <div class="container position-relative">
                        <div class="row align-items-center min-vh-50 g-4">
                            <div class="col-lg-5 py-5">
                                <span class="ew-eyebrow">ELY WORLD ACCESS</span>
                                <h1>KẾT NỐI NÔNG SẢN VIỆT<br/>VỚI THỊ TRƯỜNG TOÀN CẦU</h1>
                                <p>Sản phẩm chất lượng – Nguồn gốc rõ ràng – Đáp ứng tiêu chuẩn quốc tế.</p>
                                <div class="d-flex flex-wrap gap-3">
                                    <a class="btn ew-btn-primary" href="/shop">
                                        Khám phá sản phẩm <i class="fa fa-arrow-right ms-2"/>
                                    </a>
                                    <a class="btn ew-btn-outline" href="#contact">Nhận tư vấn</a>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <img class="img-fluid ew-hero-image"
                                     src="/sale_website_home/static/src/img/hero-placeholder.svg"
                                     alt="Sale Demo export products" loading="eager"/>
                            </div>
                        </div>
                    </div>
                </section>
    </template>

