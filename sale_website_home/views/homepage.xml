<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Snippet 1: Video Hero Section with Fully Editable Hero Card Media -->
    <template id="s_sale_hero" name="Sale Hero">
        <section class="sale-hero bg-dark text-white py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0d6efd 100%);">
            <div class="container position-relative z-1 py-lg-5">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7 text-center text-lg-start">
                        <span class="badge bg-danger bg-opacity-20 text-ccvi-red border border-danger border-opacity-30 px-3 py-2 rounded-pill fw-bold text-uppercase tracking-wider mb-3">
                            🚀 Giải Pháp Bán Hàng &amp; ERP Doanh Nghiệp
                        </span>
                        <h1 class="display-4 fw-extrabold text-white mb-4 lh-tight">
                            Nâng Tầm Thương Hiệu <br/>
                            <span class="text-ccvi-red gradient-text fw-bold">Bán Hàng &amp; Xuất Khẩu B2B</span>
                        </h1>
                        <p class="lead text-white fw-medium mb-4 pe-lg-4 fs-5" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
                            Hệ thống tích hợp toàn diện Website Bán Hàng, Thương Mại Điện Tử, Quản Lý Kho &amp; CRM Chăm Sóc Khách Hàng tự động hóa chuẩn hóa quy trình chốt đơn.
                        </p>
                        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                            <a href="/shop" class="btn btn-ccvi-red btn-lg rounded-pill px-4 py-3 fw-bold shadow-lg text-white">
                                <i class="fa fa-shopping-cart me-2"/> Khám Phá Sản Phẩm
                            </a>
                            <a href="/contactus" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3 fw-bold text-white">
                                <i class="fa fa-paper-plane me-2"/> Nhận Báo Giá Sỉ
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <!-- Fully Editable High-Contrast Hero Card -->
                        <div class="hero-card bg-white rounded-4 p-4 p-lg-5 shadow-2xl text-center border-top border-4" style="border-top-color: #e84336 !important;">
                            <div class="mb-3 hero-media-box d-flex justify-content-center align-items-center">
                                <span class="fa fa-line-chart text-ccvi-red display-4 p-3 bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center hero-media-icon"
                                      style="width: 80px; height: 80px; cursor: pointer;"
                                      title="Nhấp đúp để đổi Icon hoặc Ảnh"/>
                            </div>
                            <h3 class="fw-bold text-dark mb-2">Tối Ưu 300% Tỷ Lệ Chuyển Đổi</h3>
                            <p class="text-secondary-dark fs-6 mb-4 fw-normal" style="color: #334155;">
                                Giao diện tối ưu chuẩn UX/UI, tốc độ tải trang dưới 1s, tự động đồng bộ Yêu cầu Báo giá về CRM Odoo Backend.
                            </p>
                            <a href="/contactus" class="btn btn-ccvi-red rounded-pill w-100 fw-bold py-3 shadow-md text-white fs-6">
                                Tư Vấn Giải Pháp Trực Tiếp <i class="fa fa-arrow-right ms-1"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet 2: Dynamic Product Categories with Image Upload Support -->
    <template id="s_sale_categories" name="Sale Categories">
        <section class="sale-categories py-5 bg-light position-relative overflow-hidden">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="badge bg-danger bg-opacity-10 text-ccvi-red fw-bold text-uppercase px-3 py-2 rounded-pill mb-2">Danh mục sản phẩm</span>
                    <h2 class="display-6 fw-bold text-dark mb-3">Khám Phá Danh Mục Nông Sản B2B</h2>
                    <p class="text-secondary-dark fs-6 max-w-2xl mx-auto fw-medium" style="color: #334155;">Tất cả sản phẩm đều được kiểm định chất lượng xuất khẩu chuẩn quốc tế</p>
                </div>
                
                <t t-set="categories" t-value="request.env['product.public.category'].search([], order='sequence asc')"/>
                
                <div class="row g-4">
                    <t t-foreach="categories" t-as="cat">
                        <div class="col-lg-3 col-md-6">
                            <a t-att-href="'/shop/category/%s' % cat.id" class="text-decoration-none">
                                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 text-center hover-lift transition-all bg-white">
                                    <div class="icon-wrapper mx-auto mb-3 bg-danger bg-opacity-10 text-ccvi-red rounded-circle d-flex align-items-center justify-content-center overflow-hidden" style="width: 75px; height: 75px;">
                                        <t t-if="cat.image_128">
                                            <img t-att-src="'/web/image/product.public.category/%s/image_128' % cat.id"
                                                 t-att-alt="cat.name"
                                                 class="img-fluid w-100 h-100"
                                                 style="object-fit: cover;"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-cubes fs-3"/>
                                        </t>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-2"><t t-out="cat.name"/></h5>
                                    <span class="btn btn-sm btn-outline-primary rounded-pill px-3 mt-2 fw-semibold">Xem ngay <i class="fa fa-arrow-right ms-1"/></span>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet 3: Dynamic Featured Products -->
    <template id="s_sale_featured_products" name="Sale Featured Products">
        <section class="sale-featured-products py-5 bg-white position-relative">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
                    <div>
                        <span class="badge bg-danger bg-opacity-10 text-danger fw-bold text-uppercase px-3 py-2 rounded-pill mb-2">🔥 Sản phẩm bán chạy</span>
                        <h2 class="display-6 fw-bold text-dark mb-0">Sản Phẩm Xuất Khẩu Tiêu Biểu</h2>
                    </div>
                    <a href="/shop" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold">Tất cả sản phẩm <i class="fa fa-arrow-right ms-1"/></a>
                </div>
                
                <t t-set="featured_prods" t-value="request.env['product.template'].search([('website_published', '=', True)], limit=8)"/>
                
                <div class="row g-4">
                    <t t-foreach="featured_prods" t-as="product">
                        <div class="col-lg-3 col-md-6">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden hover-card transition-all position-relative">
                                <span class="position-absolute top-0 end-0 badge bg-danger m-3 rounded-pill px-3 py-2 fw-bold fs-7 z-1">HOT</span>
                                
                                <a t-att-href="'/shop/%s' % product.id" class="text-decoration-none">
                                    <div class="bg-light d-flex align-items-center justify-content-center p-3" style="height: 200px;">
                                        <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                                             t-att-alt="product.name"
                                             class="img-fluid rounded-3"
                                             style="max-height: 170px; object-fit: contain;"
                                             onerror="this.onerror=null; this.src='/web/static/src/img/placeholder.png';"/>
                                    </div>
                                </a>
                                
                                <div class="card-body p-4 d-flex flex-column justify-content-between">
                                    <div>
                                        <span t-if="product.public_categ_ids" class="text-ccvi-blue fs-7 fw-bold text-uppercase d-block mb-1">
                                            <t t-out="product.public_categ_ids[0].name"/>
                                        </span>
                                        <h6 class="fw-bold text-dark mb-2 text-truncate-2" style="min-height: 2.8rem;">
                                            <a t-att-href="'/shop/%s' % product.id" class="text-dark text-decoration-none hover-primary">
                                                <t t-out="product.name"/>
                                            </a>
                                        </h6>
                                    </div>
                                    
                                    <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-3">
                                        <div>
                                            <span class="fs-5 fw-bold text-danger">
                                                <t t-out="'{:,.0f}'.format(product.list_price).replace(',', '.') + ' đ'"/>
                                            </span>
                                        </div>
                                        <a t-att-href="'/shop/%s' % product.id" class="btn btn-ccvi-red rounded-circle btn-icon shadow-sm text-white" title="Xem chi tiết">
                                            <i class="fa fa-shopping-cart"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet 4: About Section -->
    <template id="s_sale_about" name="Sale About Us">
        <section class="sale-about py-5 bg-light position-relative">
            <div class="container py-lg-4">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <div class="position-relative">
                            <div class="p-5 bg-danger bg-opacity-10 rounded-5 border border-danger border-opacity-20 text-center">
                                <span class="fa fa-shield text-ccvi-red display-1 mb-3 d-inline-block"/>
                                <h3 class="fw-bold text-dark mb-2">Chứng Nhận Chất Lượng Quốc Tế</h3>
                                <p class="text-dark fw-semibold mb-0">HACCP • ISO 22000 • FDA Certified • VietGAP</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold text-uppercase px-3 py-2 rounded-pill mb-2">Về Sale Demo</span>
                        <h2 class="display-6 fw-bold text-dark mb-4">Năng Lực Cung Ứng &amp; Xuất Khẩu Toàn Cầu</h2>
                        <p class="text-secondary-dark fs-6 mb-4 fw-normal" style="color: #334155;">
                            Chúng tôi chuyên sản xuất và cung ứng các mặt hàng nông sản sấy dẻo, hạt dinh dưỡng và cà phê chất lượng cao. Với quy trình kiểm soát nghiêm ngặt từ nông trại tới nhà máy, Sale Demo tự hào là đối tác tin cậy của hơn 500+ doanh nghiệp bán lẻ và đối tác xuất khẩu.
                        </p>
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-ccvi-red text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px; height:40px;"><i class="fa fa-check"/></div>
                                    <span class="fw-semibold text-dark">Nguồn hàng ổn định</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-ccvi-red text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:40px; height:40px;"><i class="fa fa-check"/></div>
                                    <span class="fw-semibold text-dark">Giá gốc tận xưởng</span>
                                </div>
                            </div>
                        </div>
                        <a href="/about-us" class="btn btn-dark rounded-pill px-4 py-2 fw-bold text-white">Tìm Hiểu Thêm <i class="fa fa-arrow-right ms-1"/></a>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Snippet 5: Contact Lead Form -->
    <template id="s_sale_contact" name="Sale Contact Snippet">
        <section class="sale-contact py-5 bg-white position-relative">
            <div class="container">
                <div class="bg-dark bg-gradient rounded-5 p-4 p-lg-5 text-white shadow-lg" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #e84336 100%) !important;">
                    <div class="row align-items-center g-4">
                        <div class="col-lg-6">
                            <h2 class="display-6 fw-bold text-white mb-3">Yêu Cầu Báo Giá Xuất Khẩu / Bán Sỉ</h2>
                            <p class="text-white fs-6 mb-4 fw-normal">
                                Để nhận bảng giá sỉ chi tiết và chính sách chiết khấu tốt nhất cho đại lý / doanh nghiệp, vui lòng điền thông tin bên dưới. Đội ngũ kinh doanh sẽ tư vấn ngay trong 15 phút.
                            </p>
                            <div class="d-flex align-items-center gap-4">
                                <div>
                                    <h4 class="fw-bold text-white mb-0">1500+</h4>
                                    <span class="fs-7 text-white fw-medium">Đơn hàng B2B</span>
                                </div>
                                <div class="vr bg-white opacity-50"/>
                                <div>
                                    <h4 class="fw-bold text-white mb-0">99.8%</h4>
                                    <span class="fs-7 text-white fw-medium">Hài lòng</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <form action="/sale/contact/submit" method="post" class="bg-white p-4 rounded-4 shadow-sm text-dark">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <h5 class="fw-bold text-ccvi-red mb-3">Đăng Ký Tư Vấn Báo Giá</h5>
                                <div class="mb-3">
                                    <input type="text" name="name" class="form-control rounded-pill px-3" placeholder="Họ và tên *" required="required"/>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <input type="tel" name="phone" class="form-control rounded-pill px-3" placeholder="Số điện thoại *" required="required"/>
                                    </div>
                                    <div class="col-6">
                                        <input type="email" name="email" class="form-control rounded-pill px-3" placeholder="Email liên hệ"/>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <textarea name="description" class="form-control rounded-3 px-3" rows="3" placeholder="Sản phẩm quan tâm &amp; Số lượng dự kiến..."/>
                                </div>
                                <button type="submit" class="btn btn-ccvi-red rounded-pill w-100 fw-bold py-2 shadow-sm">
                                    Gửi Yêu Cầu Báo Giá <i class="fa fa-paper-plane ms-1"/>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Homepage Layout Override -->
    <template id="sale_homepage" inherit_id="website.homepage" name="Sale Website Homepage" priority="1000">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="ew-homepage">
                <div class="oe_structure oe_empty" id="sale_zone_1"/>
                <t t-call="sale_website_home.s_sale_hero"/>
                <div class="oe_structure oe_empty" id="sale_zone_2"/>
                <t t-call="sale_website_home.s_sale_categories"/>
                <div class="oe_structure oe_empty" id="sale_zone_3"/>
                <t t-call="sale_website_home.s_sale_featured_products"/>
                <div class="oe_structure oe_empty" id="sale_zone_4"/>
                <t t-call="sale_website_home.s_sale_about"/>
                <div class="oe_structure oe_empty" id="sale_zone_5"/>
                <t t-call="sale_website_home.s_sale_contact"/>
                <div class="oe_structure oe_empty" id="sale_zone_6"/>
            </div>
        </xpath>
    </template>
</odoo>
