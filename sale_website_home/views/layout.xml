<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Website Layout Override -->
    <template id="sale_layout_override" inherit_id="website.layout" name="Sale Master Layout" priority="1000">
        <!-- Error boundary & Unhandled Rejection Suppressor for Lazy Load Chrome Interventions -->
        <xpath expr="//head" position="inside">
            <script>
                window.addEventListener('unhandledrejection', function (event) {
                    if (event.reason &amp;&amp; (
                        event.reason.message &amp;&amp; (
                            event.reason.message.includes("querySelector") || 
                            event.reason.message.includes("placeholder")
                        )
                    )) {
                        event.preventDefault();
                    }
                });
            </script>

            <!-- Custom Brand Theme Utilities -->
            <style>
                :root {
                    --ccvi-red: #e84336;
                    --ccvi-blue: #2563eb;
                    --ccvi-green: #31a853;
                    --ccvi-dark: #0f172a;
                }
                .bg-ccvi-red { background-color: #e84336 !important; }
                .text-ccvi-red { color: #e84336 !important; }
                .border-ccvi-red { border-color: #e84336 !important; }
                
                .bg-ccvi-blue { background-color: #2563eb !important; }
                .text-ccvi-blue { color: #2563eb !important; }

                .bg-ccvi-dark { background-color: #0f172a !important; }
                .text-ccvi-dark { color: #0f172a !important; }

                .btn-ccvi-red, .btn-primary {
                    background-color: #e84336 !important;
                    border-color: #e84336 !important;
                    color: #ffffff !important;
                    box-shadow: 0 4px 15px rgba(232, 67, 54, 0.3) !important;
                    transition: all 0.3s ease;
                    position: relative;
                    overflow: hidden;
                }
                .btn-ccvi-red::after, .btn-primary::after { content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); transform: skewX(-20deg); animation: shine 3.5s infinite; }
                .btn-ccvi-red:hover, .btn-primary:hover { background-color: #d32f2f !important; border-color: #d32f2f !important; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(232, 67, 54, 0.4) !important; }

                .btn-outline-primary { color: #2563eb !important; border-color: #2563eb !important; }
                .btn-outline-primary:hover { background-color: #2563eb !important; color: #ffffff !important; }

                .backdrop-blur { backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
                .hero-card { animation: floatCard 4s ease-in-out infinite; }
                .hover-lift { transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s ease; }
                .hover-lift:hover { transform: translateY(-6px); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1) !important; }
                .hover-card { transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); }
                .hover-card:hover { transform: translateY(-4px); }

                .sale-floating-contact { position: fixed; bottom: 25px; right: 25px; z-index: 1040; display: flex; flex-direction: column; gap: 12px; }
                .sale-floating-contact .btn-floating { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #fff; box-shadow: 0 6px 20px rgba(0,0,0,0.25); transition: all 0.3s ease; text-decoration: none; }
                .sale-floating-contact .btn-floating:hover { transform: scale(1.12); }
                .sale-floating-contact .btn-zalo { background: #0068ff; }
                .sale-floating-contact .btn-phone { background: #e84336; animation: pulseGlow 2s infinite; }
                .sale-floating-contact .btn-quote { background: #2563eb; }

                /* Ultra-Readable High-Contrast Sales Toast Styling */
                .sale-toast-notification { position: fixed; bottom: 25px; left: 25px; z-index: 1040; max-width: 380px; background: #ffffff; border-radius: 1rem; box-shadow: 0 10px 30px rgba(0,0,0,0.18); border-left: 5px solid #e84336; padding: 14px 18px; animation: salesToastSlide 0.5s ease-out; transition: opacity 0.4s ease; }
                .sale-toast-notification .toast-title { color: #0f172a !important; font-weight: 700; font-size: 0.9rem; }
                .sale-toast-notification .toast-time { background-color: #f1f5f9; color: #475569 !important; font-weight: 600; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; }
                .sale-toast-notification p { color: #334155 !important; font-size: 0.85rem; line-height: 1.35; margin-bottom: 0; }
                .sale-toast-notification p strong { color: #e84336 !important; font-weight: 700; }
            </style>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    if (!document.querySelector('.sale-toast-notification')) {
                        let toasts = [
                            { name: "Anh Minh (TP.HCM)", text: "vừa gửi yêu cầu báo giá sỉ <strong>Cà Phê Robusta Honey</strong>", time: "2 phút trước", image: "" },
                            { name: "Chị Thu Hà (Hà Nội)", text: "vừa đặt mua 100 thùng <strong>Xoài Sấy Dẻo Export</strong>", time: "5 phút trước", image: "" },
                            { name: "Công ty Nông Sản Á Châu", text: "vừa đăng ký đại lý <strong>Hạt Điều Rang Muối</strong>", time: "12 phút trước", image: "" }
                        ];

                        const toastContainer = document.createElement('div');
                        toastContainer.className = 'sale-toast-notification d-none d-md-flex align-items-center gap-3';
                        document.body.appendChild(toastContainer);

                        let index = 0;
                        const showToast = function () {
                            if (!toasts.length) return;
                            const item = toasts[index];
                            const imgHtml = item.image 
                                ? `<img src="${item.image}" class="rounded-circle shadow-sm" style="width: 44px; height: 44px; object-fit: cover; flex-shrink: 0;" onerror="this.style.display='none'"/>`
                                : `<div class="toast-icon bg-danger bg-opacity-10 text-danger rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;"><i class="fa fa-shopping-bag fs-5"></i></div>`;

                            toastContainer.innerHTML = `
                                ${imgHtml}
                                <div class="toast-body flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="toast-title">${item.name}</strong>
                                        <span class="toast-time">${item.time}</span>
                                    </div>
                                    <p class="mb-0 lh-sm">${item.text}</p>
                                </div>
                                <button type="button" class="btn-close btn-close-toast fs-8 ms-1" aria-label="Close"></button>
                            `;
                            toastContainer.style.display = 'flex';
                            toastContainer.style.opacity = '1';

                            const closeBtn = toastContainer.querySelector('.btn-close-toast');
                            if (closeBtn) {
                                closeBtn.addEventListener('click', function () {
                                    toastContainer.style.opacity = '0';
                                    setTimeout(function () { toastContainer.style.display = 'none'; }, 400);
                                });
                            }
                            index = (index + 1) % toasts.length;
                        };

                        fetch('/sale/get_toasts', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ jsonrpc: "2.0", method: "call", params: {} })
                        }).then(function(res) { return res.json(); })
                          .then(function(data) {
                              if (data &amp;&amp; data.result &amp;&amp; data.result.length) {
                                  toasts = data.result;
                              }
                          }).catch(function(e){ console.log("Toast RPC info:", e); });

                        setTimeout(showToast, 3000);
                        setInterval(showToast, 10000);
                    }
                });
            </script>
        </xpath>

        <!-- Header Replacement -->
        <xpath expr="//header" position="replace">
            <header id="top" class="sale-site-header sticky-top bg-white shadow-sm">
                <!-- Topbar -->
                <div class="sale-topbar bg-dark text-white py-1 fs-7">
                    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-none d-md-inline text-white-50"><i class="fa fa-clock-o me-1 text-ccvi-red"/> T2 - T7: 08:00 - 18:00</span>
                            <span class="fw-semibold text-white">CCVI Technology — Hệ Thống Bán Hàng &amp; Quản Trị ERP Enterprise</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a t-if="website.company_id.phone"
                               t-att-href="'tel:%s' % website.company_id.phone.replace(' ', '')"
                               class="text-white text-decoration-none hover-primary fw-medium">
                                <i class="fa fa-phone me-1 text-ccvi-red"/>
                                <t t-out="website.company_id.phone"/>
                            </a>
                            <a t-if="website.company_id.email"
                               t-att-href="'mailto:%s' % website.company_id.email"
                               class="text-white text-decoration-none d-none d-sm-inline hover-primary fw-medium">
                                <i class="fa fa-envelope me-1 text-ccvi-blue"/>
                                <t t-out="website.company_id.email"/>
                            </a>
                            <t t-call="website.language_selector"/>
                        </div>
                    </div>
                </div>

                <!-- Main Navbar -->
                <nav class="navbar navbar-expand-lg navbar-light py-2 sale-navbar">
                    <div class="container">
                        <!-- Brand Logo CCVI Technology -->
                        <a class="navbar-brand sale-brand fw-bold fs-4 text-primary d-flex align-items-center gap-2 me-lg-4" href="/" aria-label="CCVI Technology Home">
                            <img src="/logo.png" alt="CCVI Technology" class="img-fluid navbar-logo" style="max-height: 48px; object-fit: contain;"/>
                        </a>

                        <!-- Mobile Quick Cart -->
                        <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
                            <a class="btn btn-sm btn-icon btn-light rounded-circle shadow-sm" href="/shop/cart" aria-label="Giỏ hàng">
                                <i class="fa fa-shopping-bag text-ccvi-red"/>
                            </a>
                        </div>

                        <!-- Mobile Toggler -->
                        <button class="navbar-toggler border-0 shadow-none" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#saleMainNavigation"
                                aria-controls="saleMainNavigation"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"/>
                        </button>

                        <!-- Nav Links & Action Bar -->
                        <div class="collapse navbar-collapse" id="saleMainNavigation">
                            <!-- Dynamic CMS Navigation Menu -->
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 sale-main-menu fw-medium gap-lg-1">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-if="submenu.is_visible">
                                        <li t-if="not submenu.child_id" class="nav-item">
                                            <a class="nav-link px-3 fw-semibold text-dark" t-att-href="submenu.url">
                                                <t t-out="submenu.name"/>
                                            </a>
                                        </li>
                                        <li t-else="" class="nav-item dropdown">
                                            <a class="nav-link px-3 dropdown-toggle fw-semibold text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <t t-out="submenu.name"/>
                                            </a>
                                            <ul class="dropdown-menu border-0 shadow-sm rounded-3 p-2">
                                                <t t-foreach="submenu.child_id" t-as="child">
                                                    <li t-if="child.is_visible">
                                                        <a class="dropdown-item py-2 px-3 rounded-2 fw-medium fs-7 text-dark" t-att-href="child.url">
                                                            <t t-out="child.name"/>
                                                        </a>
                                                    </li>
                                                </t>
                                            </ul>
                                        </li>
                                    </t>
                                </t>
                            </ul>

                            <!-- Action Bar (🔍 Search, 🛒 Cart, 👤 User, 🚀 CTA) -->
                            <div class="d-flex align-items-center gap-2 gap-md-3 sale-header-actions ms-lg-3 mt-3 mt-lg-0">
                                <!-- 🔍 Search Icon -->
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm text-dark" href="/shop" aria-label="Tìm kiếm sản phẩm" title="Tìm kiếm">
                                    <i class="fa fa-search text-dark"/>
                                </a>
                                
                                <!-- 🛒 Cart Icon with Badge -->
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm position-relative" href="/shop/cart" aria-label="Giỏ hàng" title="Giỏ hàng">
                                    <i class="fa fa-shopping-bag text-ccvi-blue"/>
                                </a>

                                <!-- 👤 User Profile / Login -->
                                <t t-if="user_id._is_public()">
                                    <a href="/web/login" class="btn btn-outline-primary rounded-pill px-3 py-1 me-1 fw-semibold fs-7" title="Đăng nhập">
                                        <i class="fa fa-user me-1"/> Đăng nhập
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="/my/home" class="btn btn-light rounded-circle shadow-sm me-1" title="Tài khoản của tôi">
                                        <i class="fa fa-user-circle text-ccvi-blue fs-5"/>
                                    </a>
                                </t>

                                <!-- 🚀 CTA Button -->
                                <a href="/contactus" class="btn btn-ccvi-red rounded-pill px-3 py-2 fw-bold text-white fs-7 d-none d-sm-inline-block shadow-sm">
                                    <i class="fa fa-paper-plane me-1"/> Nhận Báo Giá B2B
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>

        <!-- Footer Replacement -->
        <xpath expr="//footer" position="replace">
            <footer id="bottom" class="sale-footer bg-dark text-white pt-5 pb-3 border-top border-dark position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;">
                <div class="container py-4">
                    <div class="row g-4 mb-4">
                        <!-- Brand Info Column -->
                        <div class="col-lg-4 col-md-6 pe-lg-4">
                            <a href="/" class="d-flex align-items-center gap-2 mb-3 text-decoration-none">
                                <img src="/logo.png" alt="CCVI Technology Logo" style="max-height: 45px; object-fit: contain;"/>
                            </a>
                            <p class="text-white-50 fs-7 lh-base mb-3">
                                <t t-out="website.company_id.name"/> — Hệ thống tích hợp toàn diện giải pháp Website Bán Hàng, Thương Mại Điện Tử &amp; Quản Trị Doanh Nghiệp ERP chuẩn hóa quy trình xuất khẩu B2B.
                            </p>
                            <div class="d-flex align-items-center gap-2 text-white">
                                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 px-3 py-2 rounded-pill fs-8 fw-semibold">
                                    ✓ Verified Partner
                                </span>
                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-3 py-2 rounded-pill fs-8 fw-semibold">
                                    ✓ SSL 256-bit
                                </span>
                            </div>
                        </div>

                        <!-- Quick Links -->
                        <div class="col-lg-2 col-md-6">
                            <h6 class="fw-bold text-white text-uppercase tracking-wider fs-7 mb-3">Sản Phẩm Main</h6>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 fs-7">
                                <li><a href="/shop" class="text-white-50 text-decoration-none hover-white">Nông sản sấy dẻo</a></li>
                                <li><a href="/shop" class="text-white-50 text-decoration-none hover-white">Cà phê Robusta / Arabica</a></li>
                                <li><a href="/shop" class="text-white-50 text-decoration-none hover-white">Hạt dinh dưỡng xuất khẩu</a></li>
                                <li><a href="/shop" class="text-white-50 text-decoration-none hover-white">Bảng giá sỉ B2B</a></li>
                            </ul>
                        </div>

                        <!-- Company Links -->
                        <div class="col-lg-2 col-md-6">
                            <h6 class="fw-bold text-white text-uppercase tracking-wider fs-7 mb-3">Về Chúng Tôi</h6>
                            <ul class="list-unstyled mb-0 d-flex flex-column gap-2 fs-7">
                                <li><a href="/about-us" class="text-white-50 text-decoration-none hover-white">Giới thiệu doanh nghiệp</a></li>
                                <li><a href="/contactus" class="text-white-50 text-decoration-none hover-white">Chứng nhận chất lượng</a></li>
                                <li><a href="/blog" class="text-white-50 text-decoration-none hover-white">Tin tức nông sản</a></li>
                                <li><a href="/contactus" class="text-white-50 text-decoration-none hover-white">Liên hệ hợp tác</a></li>
                            </ul>
                        </div>

                        <!-- Contact Info Column -->
                        <div class="col-lg-4 col-md-6">
                            <h6 class="fw-bold text-white text-uppercase tracking-wider fs-7 mb-3">Thông Tin Liên Hệ</h6>
                            <ul class="list-unstyled mb-3 d-flex flex-column gap-2 fs-7 text-white-50">
                                <li class="d-flex align-items-start gap-2">
                                    <i class="fa fa-map-marker text-ccvi-red mt-1"/>
                                    <span>Tòa nhà CCVI Building, TP. Hồ Chí Minh, Việt Nam</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa fa-phone text-ccvi-red"/>
                                    <span>Hotline: <a t-att-href="'tel:%s' % website.company_id.phone" class="text-white fw-bold text-decoration-none"><t t-out="website.company_id.phone"/></a></span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <i class="fa fa-envelope text-ccvi-blue"/>
                                    <span>Email: <a t-att-href="'mailto:%s' % website.company_id.email" class="text-white text-decoration-none"><t t-out="website.company_id.email"/></a></span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Bottom Bar Copyright -->
                    <div class="border-top border-white border-opacity-10 pt-3 d-flex flex-wrap align-items-center justify-content-between gap-2 fs-8 text-white-50">
                        <div>
                            © <t t-out="datetime.datetime.now().year"/> <strong class="text-white"><t t-out="website.company_id.name"/></strong>. All Rights Reserved. Powered by Odoo ERP Enterprise.
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a href="/privacy" class="text-white-50 text-decoration-none hover-white">Chính sách bảo mật</a>
                            <span>•</span>
                            <a href="/terms" class="text-white-50 text-decoration-none hover-white">Điều khoản dịch vụ</a>
                        </div>
                    </div>
                </div>
            </footer>

            <!-- Floating Contact Quick Action Buttons -->
            <div class="sale-floating-contact">
                <a t-if="website.company_id.phone"
                   t-att-href="'https://zalo.me/%s' % website.company_id.phone.replace(' ', '')"
                   target="_blank"
                   class="btn-floating btn-zalo shadow"
                   title="Chat Zalo ngay">
                    <span class="fw-bold fs-7">Zalo</span>
                </a>
                <a t-if="website.company_id.phone"
                   t-att-href="'tel:%s' % website.company_id.phone.replace(' ', '')"
                   class="btn-floating btn-phone shadow"
                   title="Gọi Hotline tư vấn">
                    <i class="fa fa-phone"/>
                </a>
                <a href="/contactus"
                   class="btn-floating btn-quote shadow"
                   title="Nhận báo giá nhanh">
                    <i class="fa fa-paper-plane"/>
                </a>
            </div>
        </xpath>
    </template>
</odoo>
