<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_website_layout_header_footer"
              inherit_id="website.layout"
              name="Sale Website Header and Footer"
              priority="1000">

        <xpath expr="//header" position="replace">
            <header id="top" class="sale-site-header sticky-top bg-white shadow-sm">
                <!-- Topbar -->
                <div class="sale-topbar bg-dark text-white py-1 fs-7">
                    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-none d-md-inline"><i class="fa fa-clock-o me-1 text-primary"/> T2 - T7: 08:00 - 18:00</span>
                            <span class="fw-semibold text-light">Mẫu Website Bán Hàng &amp; Quản Lý CRM Doanh Nghiệp</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a t-if="website.company_id.phone"
                               t-att-href="'tel:%s' % website.company_id.phone.replace(' ', '')"
                               class="text-white text-decoration-none hover-primary">
                                <i class="fa fa-phone me-1 text-primary"/>
                                <t t-out="website.company_id.phone"/>
                            </a>
                            <a t-if="website.company_id.email"
                               t-att-href="'mailto:%s' % website.company_id.email"
                               class="text-white text-decoration-none d-none d-sm-inline hover-primary">
                                <i class="fa fa-envelope me-1 text-primary"/>
                                <t t-out="website.company_id.email"/>
                            </a>
                            <t t-call="website.language_selector"/>
                        </div>
                    </div>
                </div>

                <!-- Main Navbar -->
                <nav class="navbar navbar-expand-lg navbar-light py-2 sale-navbar">
                    <div class="container">
                        <!-- Brand Logo -->
                        <a class="navbar-brand sale-brand fw-bold fs-4 text-primary d-flex align-items-center gap-2 me-lg-4" href="/" aria-label="Sale Demo Home">
                            <span t-field="website.logo" t-options="{'widget': 'image', 'class': 'img img-fluid navbar-logo', 'alt': 'Sale Demo'}" />
                            <span t-if="not website.logo" class="brand-text text-uppercase tracking-wider">Sale Demo</span>
                        </a>

                        <!-- Mobile Quick Cart -->
                        <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
                            <a class="btn btn-sm btn-icon btn-light rounded-circle shadow-sm" href="/shop/cart" aria-label="Giỏ hàng">
                                <i class="fa fa-shopping-bag text-primary"/>
                            </a>
                        </div>

                        <!-- Mobile Toggler -->
                        <button class="navbar-toggler border-0 shadow-none" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#saleMainNavigation"
                                aria-controls="saleMainNavigation"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"/>
                        </button>

                        <!-- Nav Links & Action Bar -->
                        <div class="collapse navbar-collapse" id="saleMainNavigation">
                            <!-- Dynamic CMS Navigation Menu -->
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 sale-main-menu fw-medium gap-lg-1">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class" t-value="'nav-item'"/>
                                        <t t-set="link_class" t-value="'nav-link px-3'"/>
                                    </t>
                                </t>
                            </ul>

                            <!-- Action Bar (🔍 Search, 🛒 Cart, 👤 User, 🚀 CTA) -->
                            <div class="d-flex align-items-center gap-2 gap-md-3 sale-header-actions ms-lg-3 mt-3 mt-lg-0">
                                <!-- 🔍 Search Icon -->
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm" href="/shop" aria-label="Tìm kiếm sản phẩm" title="Tìm kiếm">
                                    <i class="fa fa-search text-secondary"/>
                                </a>
                                
                                <!-- 🛒 Cart Icon with Badge -->
                                <t t-set="website_sale_order" t-value="website.sale_get_order() if website else False"/>
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm position-relative" href="/shop/cart" aria-label="Giỏ hàng" title="Giỏ hàng">
                                    <i class="fa fa-shopping-bag text-primary"/>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger fs-8">
                                        <t t-out="website_sale_order and website_sale_order.cart_quantity or 0"/>
                                    </span>
                                </a>

                                <!-- 👤 User Profile / Login -->
                                <t t-if="user_id._is_public()">
                                    <a href="/web/login" class="btn btn-outline-primary rounded-pill px-3 py-1 me-1 fw-semibold fs-7" title="Đăng nhập">
                                        <i class="fa fa-user me-1"/> Đăng nhập
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="/my/home" class="btn btn-light rounded-circle shadow-sm me-1" title="Tài khoản của tôi">
                                        <i class="fa fa-user-circle text-primary fs-5"/>
                                    </a>
                                </t>

                                <!-- 🚀 Primary CTA Button -->
                                <a href="/contactus" class="btn btn-primary rounded-pill px-3 py-2 fw-bold text-white shadow-sm d-inline-block">
                                    <i class="fa fa-paper-plane me-1"/> Yêu cầu Báo Giá
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>

        <!-- Footer UX Layout -->
        <xpath expr="//footer" position="replace">
            <footer class="sale-footer bg-dark text-light pt-5 pb-3">
                <div class="container">
                    <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
                        <div class="col-lg-4 col-md-6">
                            <a class="sale-footer-logo text-decoration-none fs-3 fw-bold text-white d-inline-block mb-3" href="/">
                                <span t-field="website.logo" t-options="{'widget': 'image', 'class': 'img img-fluid', 'alt': 'Sale Demo'}" />
                                <span t-if="not website.logo">Sale Demo</span>
                            </a>
                            <p class="text-secondary fs-6 pe-lg-4">
                                Nền tảng Bán hàng &amp; CRM doanh nghiệp toàn diện. Tối ưu trải nghiệm mua sắm và quy trình quản lý đơn hàng chuẩn hóa.
                            </p>
                            <div class="d-flex gap-2 mt-3">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="fa fa-facebook"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="fa fa-linkedin"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="fa fa-youtube-play"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle"><i class="fa fa-instagram"/></a>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Về chúng tôi</h6>
                            <ul class="list-unstyled sale-footer-links text-secondary">
                                <li class="mb-2"><a href="/about-us" class="text-secondary text-decoration-none hover-white">Giới thiệu</a></li>
                                <li class="mb-2"><a href="/about-us#mission" class="text-secondary text-decoration-none hover-white">Tầm nhìn &amp; Sứ mệnh</a></li>
                                <li class="mb-2"><a href="/about-us#certificates" class="text-secondary text-decoration-none hover-white">Năng lực doanh nghiệp</a></li>
                                <li class="mb-2"><a href="/contactus" class="text-secondary text-decoration-none hover-white">Đối tác &amp; Đại lý</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Sản phẩm &amp; Dịch vụ</h6>
                            <ul class="list-unstyled sale-footer-links text-secondary">
                                <li class="mb-2"><a href="/shop" class="text-secondary text-decoration-none hover-white">Tất cả sản phẩm</a></li>
                                <li class="mb-2"><a href="/shop" class="text-secondary text-decoration-none hover-white">Sản phẩm bán chạy</a></li>
                                <li class="mb-2"><a href="/shop" class="text-secondary text-decoration-none hover-white">Sản phẩm mới về</a></li>
                                <li class="mb-2"><a href="/contactus" class="text-secondary text-decoration-none hover-white">Báo giá sỉ / Xuất khẩu</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Thông tin liên hệ</h6>
                            <ul class="list-unstyled sale-contact-list text-secondary">
                                <li t-if="website.company_id.phone" class="mb-2">
                                    <i class="fa fa-phone text-primary me-2"/>
                                    <t t-out="website.company_id.phone"/>
                                </li>
                                <li t-if="website.company_id.email" class="mb-2">
                                    <i class="fa fa-envelope text-primary me-2"/>
                                    <t t-out="website.company_id.email"/>
                                </li>
                                <li t-if="website.company_id.sudo().partner_id.contact_address" class="mb-2">
                                    <i class="fa fa-map-marker text-primary me-2"/>
                                    <t t-out="website.company_id.sudo().partner_id.contact_address"/>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 fs-7 text-secondary">
                        <span>© 2026 Sale Demo Template. All rights reserved. Powered by Odoo &amp; CCVI.</span>
                        <button type="button" class="btn btn-sm btn-primary rounded-circle js_sale_scroll_top" aria-label="Lên đầu trang">
                            <i class="fa fa-arrow-up"/>
                        </button>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
