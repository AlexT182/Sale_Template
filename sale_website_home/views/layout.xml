<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_website_layout_header_footer"
              inherit_id="website.layout"
              name="Sale Website Header and Footer"
              priority="1000">

        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
            <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
            <style>
                body { font-family: 'Inter', -apple-system, sans-serif; color: #1e293b; }
                h1, h2, h3, h4, h5, h6, .display-4, .display-6, .sale-brand { font-family: 'Outfit', -apple-system, sans-serif; }
                .text-secondary-dark { color: #334155 !important; }
                .text-light-muted { color: #cbd5e1 !important; }
                .footer-link { color: #cbd5e1 !important; transition: color 0.2s ease; }
                .footer-link:hover { color: #ffffff !important; }
                
                @keyframes shine { 0% { left: -100%; } 100% { left: 125%; } }
                @keyframes pulseGlow { 0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7); } 70% { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(13, 110, 253, 0); } 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); } }
                @keyframes floatCard { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-8px); } }
                @keyframes salesToastSlide { 0% { transform: translateX(-120%); opacity: 0; } 100% { transform: translateX(0); opacity: 1; } }

                .btn-primary { position: relative; overflow: hidden; transition: all 0.3s ease; }
                .btn-primary::after { content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); transform: skewX(-20deg); animation: shine 3.5s infinite; }
                .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(13, 110, 253, 0.4) !important; }

                .backdrop-blur { backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
                .hero-card { animation: floatCard 4s ease-in-out infinite; }
                .hover-lift { transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.3s ease; }
                .hover-lift:hover { transform: translateY(-6px); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1) !important; }
                .hover-card { transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); }
                .hover-card:hover { transform: translateY(-4px); }

                .sale-floating-contact { position: fixed; bottom: 25px; right: 25px; z-index: 1040; display: flex; flex-direction: column; gap: 12px; }
                .sale-floating-contact .btn-floating { width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #fff; box-shadow: 0 6px 20px rgba(0,0,0,0.25); transition: all 0.3s ease; text-decoration: none; }
                .sale-floating-contact .btn-floating:hover { transform: scale(1.12); }
                .sale-floating-contact .btn-zalo { background: #0068ff; }
                .sale-floating-contact .btn-phone { background: #ff4757; animation: pulseGlow 2s infinite; }
                .sale-floating-contact .btn-quote { background: #0d6efd; }

                .sale-toast-notification { position: fixed; bottom: 25px; left: 25px; z-index: 1040; max-width: 350px; background: #ffffff; border-radius: 1rem; box-shadow: 0 10px 30px rgba(0,0,0,0.15); border-left: 5px solid #0d6efd; padding: 12px 16px; animation: salesToastSlide 0.5s ease-out; transition: opacity 0.4s ease; }
            </style>
        </xpath>

        <!-- Header Replacement -->
        <xpath expr="//header" position="replace">
            <header id="top" class="sale-site-header sticky-top bg-white shadow-sm">
                <!-- Topbar -->
                <div class="sale-topbar bg-dark text-white py-1 fs-7">
                    <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-none d-md-inline text-white-50"><i class="fa fa-clock-o me-1 text-primary"/> T2 - T7: 08:00 - 18:00</span>
                            <span class="fw-semibold text-white">Mẫu Website Bán Hàng &amp; Quản Lý CRM Doanh Nghiệp</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <a t-if="website.company_id.phone"
                               t-att-href="'tel:%s' % website.company_id.phone.replace(' ', '')"
                               class="text-white text-decoration-none hover-primary fw-medium">
                                <i class="fa fa-phone me-1 text-primary"/>
                                <t t-out="website.company_id.phone"/>
                            </a>
                            <a t-if="website.company_id.email"
                               t-att-href="'mailto:%s' % website.company_id.email"
                               class="text-white text-decoration-none d-none d-sm-inline hover-primary fw-medium">
                                <i class="fa fa-envelope me-1 text-primary"/>
                                <t t-out="website.company_id.email"/>
                            </a>
                            <t t-call="website.language_selector"/>
                        </div>
                    </div>
                </div>

                <!-- Main Navbar -->
                <nav class="navbar navbar-expand-lg navbar-light py-2 sale-navbar">
                    <div class="container">
                        <!-- Brand Logo -->
                        <a class="navbar-brand sale-brand fw-bold fs-4 text-primary d-flex align-items-center gap-2 me-lg-4" href="/" aria-label="Sale Demo Home">
                            <img src="/logo.png" alt="Sale Demo" class="img-fluid navbar-logo" style="max-height: 40px;"/>
                            <span class="brand-text text-uppercase tracking-wider fw-bold text-dark">Sale Demo</span>
                        </a>

                        <!-- Mobile Quick Cart -->
                        <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
                            <a class="btn btn-sm btn-icon btn-light rounded-circle shadow-sm" href="/shop/cart" aria-label="Giỏ hàng">
                                <i class="fa fa-shopping-bag text-primary"/>
                            </a>
                        </div>

                        <!-- Mobile Toggler -->
                        <button class="navbar-toggler border-0 shadow-none" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#saleMainNavigation"
                                aria-controls="saleMainNavigation"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"/>
                        </button>

                        <!-- Nav Links & Action Bar -->
                        <div class="collapse navbar-collapse" id="saleMainNavigation">
                            <!-- Dynamic CMS Navigation Menu with Dropdown Support -->
                            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 sale-main-menu fw-medium gap-lg-1">
                                <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                    <t t-if="submenu.is_visible">
                                        <li t-if="not submenu.child_id" class="nav-item">
                                            <a class="nav-link px-3 fw-semibold text-dark" t-att-href="submenu.url">
                                                <t t-out="submenu.name"/>
                                            </a>
                                        </li>
                                        <li t-else="" class="nav-item dropdown">
                                            <a class="nav-link px-3 dropdown-toggle fw-semibold text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <t t-out="submenu.name"/>
                                            </a>
                                            <ul class="dropdown-menu border-0 shadow-sm rounded-3 p-2">
                                                <t t-foreach="submenu.child_id" t-as="child">
                                                    <li t-if="child.is_visible">
                                                        <a class="dropdown-item py-2 px-3 rounded-2 fw-medium fs-7 text-dark" t-att-href="child.url">
                                                            <t t-out="child.name"/>
                                                        </a>
                                                    </li>
                                                </t>
                                            </ul>
                                        </li>
                                    </t>
                                </t>
                            </ul>

                            <!-- Action Bar (🔍 Search, 🛒 Cart, 👤 User, 🚀 CTA) -->
                            <div class="d-flex align-items-center gap-2 gap-md-3 sale-header-actions ms-lg-3 mt-3 mt-lg-0">
                                <!-- 🔍 Search Icon -->
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm text-dark" href="/shop" aria-label="Tìm kiếm sản phẩm" title="Tìm kiếm">
                                    <i class="fa fa-search text-dark"/>
                                </a>
                                
                                <!-- 🛒 Cart Icon with Badge -->
                                <a class="btn btn-icon btn-light rounded-circle shadow-sm position-relative" href="/shop/cart" aria-label="Giỏ hàng" title="Giỏ hàng">
                                    <i class="fa fa-shopping-bag text-primary"/>
                                </a>

                                <!-- 👤 User Profile / Login -->
                                <t t-if="user_id._is_public()">
                                    <a href="/web/login" class="btn btn-outline-primary rounded-pill px-3 py-1 me-1 fw-semibold fs-7" title="Đăng nhập">
                                        <i class="fa fa-user me-1"/> Đăng nhập
                                    </a>
                                </t>
                                <t t-else="">
                                    <a href="/my/home" class="btn btn-light rounded-circle shadow-sm me-1" title="Tài khoản của tôi">
                                        <i class="fa fa-user-circle text-primary fs-5"/>
                                    </a>
                                </t>

                                <!-- 🚀 Primary CTA Button -->
                                <a href="/contactus" class="btn btn-primary rounded-pill px-3 py-2 fw-bold text-white shadow-sm d-inline-block">
                                    <i class="fa fa-paper-plane me-1"/> Yêu cầu Báo Giá
                                </a>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        </xpath>

        <!-- Footer Replacement (High Contrast WCAG Standard) -->
        <xpath expr="//footer" position="replace">
            <footer class="sale-footer bg-dark text-white pt-5 pb-3">
                <div class="container">
                    <div class="row g-4 pb-4 border-bottom border-secondary border-opacity-25">
                        <div class="col-lg-4 col-md-6">
                            <a class="sale-footer-logo text-decoration-none fs-3 fw-bold text-white d-inline-flex align-items-center gap-2 mb-3" href="/">
                                <img src="/logo.png" alt="Sale Demo" class="img-fluid" style="max-height: 35px;"/>
                                <span class="text-white">Sale Demo</span>
                            </a>
                            <p class="text-light-muted fs-6 pe-lg-4">
                                Nền tảng Bán hàng &amp; Quản lý CRM doanh nghiệp toàn diện. Tối ưu trải nghiệm mua sắm và quy trình quản lý đơn hàng chuẩn hóa.
                            </p>
                            <div class="d-flex gap-2 mt-3">
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-white" aria-label="Facebook"><i class="fa fa-facebook"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-white" aria-label="LinkedIn"><i class="fa fa-linkedin"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-white" aria-label="YouTube"><i class="fa fa-youtube-play"/></a>
                                <a href="#" class="btn btn-sm btn-outline-light rounded-circle text-white" aria-label="Instagram"><i class="fa fa-instagram"/></a>
                            </div>
                        </div>

                        <div class="col-lg-2 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Về chúng tôi</h6>
                            <ul class="list-unstyled sale-footer-links">
                                <li class="mb-2"><a href="/about-us" class="footer-link text-decoration-none">Giới thiệu</a></li>
                                <li class="mb-2"><a href="/about-us#mission" class="footer-link text-decoration-none">Tầm nhìn &amp; Sứ mệnh</a></li>
                                <li class="mb-2"><a href="/about-us#certificates" class="footer-link text-decoration-none">Năng lực doanh nghiệp</a></li>
                                <li class="mb-2"><a href="/contactus" class="footer-link text-decoration-none">Đối tác &amp; Đại lý</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Sản phẩm &amp; Dịch vụ</h6>
                            <ul class="list-unstyled sale-footer-links">
                                <li class="mb-2"><a href="/shop" class="footer-link text-decoration-none">Tất cả sản phẩm</a></li>
                                <li class="mb-2"><a href="/shop" class="footer-link text-decoration-none">Sản phẩm bán chạy</a></li>
                                <li class="mb-2"><a href="/shop" class="footer-link text-decoration-none">Sản phẩm mới về</a></li>
                                <li class="mb-2"><a href="/contactus" class="footer-link text-decoration-none">Báo giá sỉ / Xuất khẩu</a></li>
                            </ul>
                        </div>

                        <div class="col-lg-3 col-md-6">
                            <h6 class="text-uppercase fw-bold text-primary mb-3">Thông tin liên hệ</h6>
                            <ul class="list-unstyled sale-contact-list text-light-muted">
                                <li t-if="website.company_id.phone" class="mb-2">
                                    <i class="fa fa-phone text-primary me-2"/>
                                    <span class="text-light"><t t-out="website.company_id.phone"/></span>
                                </li>
                                <li t-if="website.company_id.email" class="mb-2">
                                    <i class="fa fa-envelope text-primary me-2"/>
                                    <span class="text-light"><t t-out="website.company_id.email"/></span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 fs-7 text-light-muted">
                        <span class="text-light-muted">© 2026 Sale Demo Template. All rights reserved. Powered by Odoo &amp; CCVI.</span>
                    </div>
                </div>

                <!-- Floating Contact Action Group -->
                <div class="sale-floating-contact d-none d-sm-flex">
                    <a href="https://zalo.me/0901234567" target="_blank" rel="noopener" class="btn-floating btn-zalo" title="Chat Zalo B2B">
                        <i class="fa fa-comments"/>
                    </a>
                    <a href="tel:0901234567" class="btn-floating btn-phone" title="Gọi Hotline 090 123 4567">
                        <i class="fa fa-phone"/>
                    </a>
                    <a href="/contactus" class="btn-floating btn-quote" title="Nhận Báo Giá Sỉ">
                        <i class="fa fa-paper-plane"/>
                    </a>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
